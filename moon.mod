name = "SDJM5/moonphysics"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/SDJM5/moonphysics"

license = "Apache-2.0"

keywords = [ "physics", "verlet", "simulation", "wasm", "web" ]

preferred_target = "wasm"

description = "moonphysics: a 2D physics sandbox — balls, rigid boxes, ropes and tearable cloth simulated by a Verlet/position-based solver in MoonBit compiled to WebAssembly, raced live against an identical JavaScript solver."

warnings = "-test_unqualified_package"
